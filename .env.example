# Generate a long random value. Never commit the real value.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Zoho EU OAuth credentials. Store real values only in Vercel Environment Variables.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Use the api_domain returned by Zoho OAuth if available.
# For Zoho EU, this is commonly https://www.zohoapis.eu.
ZOHO_SOCIAL_API_BASE=https://www.zohoapis.eu

# Existing Alvokor Zoho Social identifiers (optional defaults for later tools).
ZOHO_SOCIAL_PORTAL_ID=935562730
ZOHO_SOCIAL_BRAND_ID=1700433000000023009
