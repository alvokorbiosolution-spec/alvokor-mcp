# Generate a long random value. Never commit the real value.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Match both URLs to the same Zoho data center (US or EU).
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Use the api_domain returned by Zoho OAuth when available.
ZOHO_SOCIAL_API_BASE=https://www.zohoapis.com

# Existing Alvokor Zoho Social identifiers (optional defaults for clients).
ZOHO_SOCIAL_PORTAL_ID=
ZOHO_SOCIAL_BRAND_ID=
